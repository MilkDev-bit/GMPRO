# =============================================================================
# auth-service — Variables de Entorno
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena cada valor con las credenciales reales
#   3. NUNCA versiones el archivo .env resultante
#   4. En Railway: Settings → Variables → Raw Editor → pega este formato
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Railway asigna el puerto automáticamente vía $PORT. No modificar en Railway.
PORT=3001
# URL pública de este servicio (Railway la genera: https://<service>.up.railway.app)
SERVICE_URL=https://auth-service.up.railway.app

# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtenidas en: supabase.com → Tu Proyecto → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# ⚠️  SERVICE_ROLE_KEY: tiene acceso total y bypasea RLS — NUNCA exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZAR
# ANON_KEY: clave pública (sin permisos elevados) — solo si se usa el cliente JS de Supabase
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZAR
# Schema propio de este microservicio (definido en el script SQL de la Tarea 1.1)
SUPABASE_DB_SCHEMA=auth_service_db

# ── JWT (JSON Web Tokens) ─────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REEMPLAZAR_CON_STRING_HEX_128_CHARS_MINIMO
# Tiempo de vida del access token (formato ms: 15m, 1h, 24h)
JWT_EXPIRES_IN=15m
# Tiempo de vida del refresh token
JWT_REFRESH_EXPIRES_IN=30d
# Expiración SERVER-SIDE del refresh token en días (autoridad real; el servidor
# rechaza el refresh si venció, aunque el cliente conserve la cookie). Opcional,
# fallback 30.
REFRESH_TOKEN_TTL_DAYS=30
# Algoritmo de firma (HS512 más seguro que HS256)
JWT_ALGORITHM=HS512

# ── Bcrypt ────────────────────────────────────────────────────────────────────
# Work factor >= 12 recomendado por OWASP (más alto = más lento = más seguro)
# No superar 14 en producción sin benchmarks de tiempo de respuesta
BCRYPT_ROUNDS=12

# ── Rate Limiting (OWASP A7) ──────────────────────────────────────────────────
# Máximo de intentos de login fallidos antes de bloquear IP
RATE_LIMIT_LOGIN_MAX=5
# Ventana de tiempo en minutos para el rate limit
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
# Máximo requests por IP en ventana general
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=1
# Límite de ALTAS por IP (cuenta también las exitosas: frena creación masiva de
# cuentas y email-bombing). Umbral generoso por NAT de gimnasio. Opcional.
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60
# Fallos de login POR CUENTA (email), independiente de la IP: frena fuerza bruta
# distribuida contra una cuenta. Solo cuenta fallos. Opcional.
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_MINUTES=60

# ── Cifrado (AES-256 para datos sensibles) ────────────────────────────────────
# Clave para cifrar historial clínico antes de persistir en Supabase
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REEMPLAZAR_CON_HEX_64_CHARS

# ── Email (para verificación y reset de contraseña) ───────────────────────────
# Proveedor: Resend.com (recomendado) o SendGrid
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_REEMPLAZAR
EMAIL_FROM=noreply@tugimnasio.com
EMAIL_FROM_NAME=GymPro

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes permitidos (separados por coma). En producción: solo tu dominio app
CORS_ALLOWED_ORIGINS=https://tugimnasio.com,https://app.tugimnasio.com

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# En Railway los logs van a stdout. 'json' facilita parseo con Datadog/Logtail
LOG_FORMAT=json
