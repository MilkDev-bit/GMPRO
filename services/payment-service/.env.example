# =============================================================================
# payment-service — Variables de Entorno
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3003
SERVICE_URL=https://payment-service.up.railway.app

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZAR
SUPABASE_DB_SCHEMA=payment_service_db

# ── Verificación de JWT ───────────────────────────────────────────────────────
JWT_SECRET=REEMPLAZAR_MISMO_VALOR_QUE_AUTH_SERVICE
JWT_ALGORITHM=HS512

# ── API Key de Pagos en Efectivo (Recepcionista) ─────────────────────────────
# Se usa para que la recepción/caja registre cobros sin sesión de usuario final.
# Debe tener mínimo 32 caracteres (generada aleatoriamente con openssl o crypto).
CASH_PAYMENT_API_KEY=REEMPLAZAR_POR_CLAVE_MAESTRA_O_KEY_DE_RECEPCION_MIN_32_CHARS

# ── Stripe ────────────────────────────────────────────────────────────────────
# Obtenida en: dashboard.stripe.com → Developers → API Keys
# ⚠️  NUNCA usar la clave de producción en desarrollo
STRIPE_SECRET_KEY=sk_live_REEMPLAZAR
# Para desarrollo local usar: sk_test_REEMPLAZAR

# Webhook secret: generado al crear el endpoint en Stripe Dashboard
# dashboard.stripe.com → Developers → Webhooks → Add endpoint
# URL del endpoint: https://payment-service.up.railway.app/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR

# ID del precio del plan mensual en Stripe (creado en Products)
# dashboard.stripe.com → Products → Tu plan → Pricing
STRIPE_PRICE_ID_MENSUAL=price_REEMPLAZAR
STRIPE_PRICE_ID_TRIMESTRAL=price_REEMPLAZAR
STRIPE_PRICE_ID_ANUAL=price_REEMPLAZAR

# Moneda por defecto para nuevas suscripciones (ISO 4217)
STRIPE_DEFAULT_CURRENCY=mxn

# ── Comunicación inter-servicios ──────────────────────────────────────────────
AUTH_SERVICE_INTERNAL_URL=https://auth-service.up.railway.app
INTER_SERVICE_SECRET=REEMPLAZAR_CON_HEX_64_CHARS
INTER_SERVICE_TIMEOUT_MS=3000

# ── Generación de Recibos PDF ─────────────────────────────────────────────────
# Nombre comercial que aparece en los comprobantes de pago
BUSINESS_NAME=GymPro
BUSINESS_RFC=REEMPLAZAR
BUSINESS_ADDRESS=Calle Ejemplo 123, Ciudad, CP 00000
BUSINESS_PHONE=+521234567890
BUSINESS_EMAIL=admin@tugimnasio.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=50
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://tugimnasio.com,https://app.tugimnasio.com

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
