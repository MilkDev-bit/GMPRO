# =============================================================================
# fitness-service — Variables de Entorno
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3004
SERVICE_URL=https://fitness-service.up.railway.app

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZAR
SUPABASE_DB_SCHEMA=fitness_schema

# ── Verificación de JWT ───────────────────────────────────────────────────────
JWT_SECRET=REEMPLAZAR_MISMO_VALOR_QUE_AUTH_SERVICE
JWT_ALGORITHM=HS512

# ── Almacenamiento de medios (videos/imágenes de ejercicios) ──────────────────
# Supabase Storage bucket para videos demostrativos de ejercicios
SUPABASE_STORAGE_BUCKET_EXERCISES=exercise-media
# URL base pública para assets de ejercicios
SUPABASE_STORAGE_PUBLIC_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/storage/v1/object/public

# ── Paginación ────────────────────────────────────────────────────────────────
# Límite de registros por página en endpoints de listado
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Cache (opcional: Redis en Railway) ────────────────────────────────────────
# El catálogo de ejercicios cambia poco → cacheable
# Agregar un servicio Redis en Railway y usar la URL privada
REDIS_URL=redis://default:REEMPLAZAR@redis.railway.internal:6379
# TTL del catálogo de ejercicios en segundos (1 hora)
EXERCISE_CATALOG_CACHE_TTL=3600

# ── Comunicación inter-servicios ──────────────────────────────────────────────
AUTH_SERVICE_INTERNAL_URL=https://auth-service.up.railway.app
INTER_SERVICE_SECRET=REEMPLAZAR_CON_HEX_64_CHARS
INTER_SERVICE_TIMEOUT_MS=3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://tugimnasio.com,https://app.tugimnasio.com

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
