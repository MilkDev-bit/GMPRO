# =============================================================================
# ai-service — Variables de Entorno
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3005
SERVICE_URL=https://ai-service.up.railway.app

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZAR
SUPABASE_DB_SCHEMA=ai_schema

# ── Verificación de JWT ───────────────────────────────────────────────────────
JWT_SECRET=REEMPLAZAR_MISMO_VALOR_QUE_AUTH_SERVICE
JWT_ALGORITHM=HS512

# ── Proveedor de IA (elegir uno y comentar el otro) ───────────────────────────

# --- Opción A: Google Gemini (recomendado para integración con Firebase) ---
# Obtener en: aistudio.google.com/app/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy_REEMPLAZAR
# Modelo a usar (2.0 Flash: balance costo/velocidad ideal para producción)
GEMINI_MODEL=gemini-2.0-flash
# Modelo para tareas de razonamiento complejo (rutinas, planes nutricionales)
GEMINI_MODEL_PRO=gemini-2.5-pro

# --- Opción B: OpenAI ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-REEMPLAZAR
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_PRO=gpt-4o
# OPENAI_ORGANIZATION_ID=org-REEMPLAZAR

# ── Límites de uso de IA (control de costos) ──────────────────────────────────
# Máximo de tokens de entrada por request (protege contra prompt injection masivo)
AI_MAX_INPUT_TOKENS=4096
# Máximo de tokens de respuesta por request
AI_MAX_OUTPUT_TOKENS=2048
# Máximo de mensajes en el historial de conversación que se envían como contexto
AI_MAX_CONTEXT_MESSAGES=20
# Límite de requests de IA por usuario por día (control de costos)
AI_REQUESTS_PER_USER_PER_DAY=50

# ── Temperatura y comportamiento del modelo ────────────────────────────────────
# 0.0 = determinista | 1.0 = creativo. Para fitness/salud usar valores bajos
AI_TEMPERATURE=0.4
# System prompt base (puede sobreescribirse con plantillas en código)
AI_SYSTEM_PERSONA=Eres GymBot, asistente personal de fitness de GymPro. Responde en español. Sé motivador, preciso y seguro. No des consejos médicos.

# ── Comunicación inter-servicios (para obtener contexto del usuario) ───────────
FITNESS_SERVICE_INTERNAL_URL=https://fitness-service.up.railway.app
AUTH_SERVICE_INTERNAL_URL=https://auth-service.up.railway.app
INTER_SERVICE_SECRET=REEMPLAZAR_CON_HEX_64_CHARS
INTER_SERVICE_TIMEOUT_MS=5000

# ── Rate Limiting (más estricto por el costo de tokens) ───────────────────────
RATE_LIMIT_AI_CHAT_MAX=10
RATE_LIMIT_AI_CHAT_WINDOW_MINUTES=1
RATE_LIMIT_GLOBAL_MAX=30
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=1

# ── Cache de recomendaciones (evitar regenerar planes idénticos) ───────────────
REDIS_URL=redis://default:REEMPLAZAR@redis.railway.internal:6379
# TTL de planes de entrenamiento generados (24 horas)
AI_RECOMMENDATION_CACHE_TTL=86400

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://tugimnasio.com,https://app.tugimnasio.com

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
# Habilitar logging de prompts/respuestas (DESHABILITAR en producción por costos de storage)
AI_LOG_PROMPTS=false
