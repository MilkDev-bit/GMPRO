# =============================================================================
# access-service — Variables de Entorno
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3002
SERVICE_URL=https://access-service.up.railway.app

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZAR
SUPABASE_DB_SCHEMA=access_service_db

# ── Verificación de JWT (Identidad del Cliente) ───────────────────────────────
JWT_SECRET=REEMPLAZAR_MISMO_VALOR_QUE_AUTH_SERVICE
JWT_ALGORITHM=HS512

# ── Criptografía QR Dinámico (AES-256-GCM) ───────────────────────────────────
# Clave maestra simétrica para cifrar los QRs.
# Debe ser una cadena hexadecimal exacta de 64 caracteres (32 bytes).
# Generar con: openssl rand -hex 32
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Retrocompatibilidad opcional:
QR_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
QR_TTL_SECONDS=30

# ── Hardware de Torniquete y Lectora ──────────────────────────────────────────
# Clave precompartida que envía la lectora QR/torniquete en el header x-turnstile-key
TURNSTILE_API_KEY=REEMPLAZAR_POR_CLAVE_HARDWARE_DE_ALTA_ENTROPIA_MIN_32_CHARS

# ── Comunicación Inter-servicio con payment-service ───────────────────────────
PAYMENT_SERVICE_INTERNAL_URL=https://payment-service.up.railway.app
INTER_SERVICE_SECRET=REEMPLAZAR_CON_HEX_64_CHARS
INTER_SERVICE_TIMEOUT_MS=2000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_QR_MAX=12
RATE_LIMIT_QR_WINDOW_SECONDS=60

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://tugimnasio.com,https://app.tugimnasio.com

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
