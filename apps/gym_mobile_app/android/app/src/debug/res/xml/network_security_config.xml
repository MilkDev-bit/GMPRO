<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de red SOLO PARA DEBUG.

  Android bloquea el tráfico HTTP en claro desde API 28. El backend
  local de Docker se sirve por http://, así que sin esto la app no puede
  hablar con él y falla con "CLEARTEXT communication not permitted",
  un error que no menciona en ningún momento la palabra "http".

  Está en src/debug/, NO en src/main/: la build de release nunca lo
  incluye, así que producción sigue exigiendo HTTPS.

  Dominios permitidos:
    10.0.2.2   → puerta de enlace al host desde el emulador de Android
    localhost  → por si se ejecuta en escritorio o web
    10.0.3.2   → equivalente en Genymotion
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Añade aquí la IP LAN de tu máquina si pruebas en un
             dispositivo físico, p. ej. 192.168.1.42 -->
    </domain-config>
</network-security-config>
