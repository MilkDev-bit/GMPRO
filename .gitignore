# =============================================================================
# GymPro Monorepo · .gitignore
# =============================================================================

# ── Variables de entorno (NUNCA versionar) ────────────────────────────────────
.env
.env.local
.env.production
.env.staging
.env.development
# Los .env.example SÍ se versionan (contienen valores ficticios como documentación)
!.env.example

# ── Node.js ────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
.cache/
coverage/
.nyc_output/
*.tsbuildinfo

# ── Flutter / Dart ────────────────────────────────────────────────────────────
apps/gym_mobile_app/.dart_tool/
apps/gym_mobile_app/.flutter-plugins
apps/gym_mobile_app/.flutter-plugins-dependencies
apps/gym_mobile_app/.pub-cache/
apps/gym_mobile_app/.pub/
apps/gym_mobile_app/build/
apps/gym_mobile_app/*.g.dart

# ── iOS (Flutter) ─────────────────────────────────────────────────────────────
apps/gym_mobile_app/ios/Pods/
apps/gym_mobile_app/ios/.symlinks/
apps/gym_mobile_app/ios/Flutter/Flutter.framework
apps/gym_mobile_app/ios/Flutter/Flutter.podspec
apps/gym_mobile_app/ios/Runner/GeneratedPluginRegistrant.*
*.xcworkspace/xcuserdata/

# ── Android (Flutter) ─────────────────────────────────────────────────────────
apps/gym_mobile_app/android/.gradle/
apps/gym_mobile_app/android/local.properties
apps/gym_mobile_app/android/key.properties        # keystore config — NUNCA versionar
apps/gym_mobile_app/android/*.jks                  # keystore file — NUNCA versionar
apps/gym_mobile_app/android/app/google-services.json  # Firebase config — gestionar por CI/CD

# ── iOS — Archivos sensibles (Firebase/APNs) ──────────────────────────────────
apps/gym_mobile_app/ios/GoogleService-Info.plist   # Firebase iOS config — gestionar por CI/CD

# ── Editores e IDEs ────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json                           # Extensiones recomendadas del equipo sí se versionan
!.vscode/settings.json                             # Settings del workspace también
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Logs ───────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── Certificados y claves privadas ────────────────────────────────────────────
*.pem
*.p12
*.p8
*.cer
*.key
*.crt

# ── Railway y Docker locales ───────────────────────────────────────────────────
.railway/

# Backups de .env generados por scripts/sync-secrets.sh — CONTIENEN SECRETOS
*.env.bak.*
.env.bak.*
services/*/.env.bak.*

# Archivos efímeros generados por Flutter (rutas de build, sin secretos)
apps/*/ios/Flutter/ephemeral/

# Caché generado por la herramienta de grafo de código (no versionar)
graphify-out/

# ── CI/CD móvil: secretos y artefactos decodificados en el runner ──────────────
# NUNCA versionar keystores, certificados, perfiles, service accounts ni el .env
# de producción que el pipeline materializa desde GitHub Secrets (Base64).
# Se ignoran los .json reales (con secretos); las plantillas *.example SÍ se versionan.
apps/*/env/*.json
# Android (nombres pelados → matchean en cualquier subdirectorio)
*.jks
*.keystore
key.properties
google-services.json
play-service-account.json
# iOS
GoogleService-Info.plist
*.p8
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
# Fastlane (locales/temporales)
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/*.log
**/fastlane/private_keys/
**/fastlane/certs/
apps/*/ios/certs/
apps/*/ios/private_keys/

# material de claves JWT — NUNCA commitear
*.b64
jwt_priv.pem
jwt_pub.pem
